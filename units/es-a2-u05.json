{
  "unit": {
    "id": "es-a2-u05",
    "title": "Imperfect",
    "subtitle": "The pretérito imperfecto: habits, descriptions, and the way things used to be",
    "level": "A2",
    "order": 5,
    "xp_reward": 20
  },
  "grammar": {
    "title": "The past that sets the scene",
    "intro": "The <b>imperfect</b> (pretérito imperfecto) is the past tense for <b>habits</b>, <b>ongoing</b> actions, and <b>descriptions</b> — think “I <b>used to</b> play” or “it <b>was</b> raining.” It's wonderfully regular: only <b>three</b> verbs break the rules. Where the preterite says a thing <i>happened</i>, the imperfect paints the background.",
    "sections": [
      {
        "tag": "-AR",
        "heading": "-AR verbs → -aba",
        "body": "For <b>-ar</b> verbs, drop the ending and add <b>-aba</b>. Notice the <b>nosotros</b> form carries an accent (habl<b>á</b>bamos):",
        "conj": [
          [
            "yo",
            "hablaba"
          ],
          [
            "tú",
            "hablabas"
          ],
          [
            "él/ella",
            "hablaba"
          ],
          [
            "nosotros",
            "hablábamos"
          ],
          [
            "vosotros",
            "hablabais"
          ],
          [
            "ellos",
            "hablaban"
          ]
        ],
        "ex": [
          {
            "es": "De niño, <b>hablaba</b> mucho.",
            "en": "As a child, I talked a lot.",
            "note": "yo and él/ella share the form"
          },
          {
            "es": "<b>Jugábamos</b> en el parque.",
            "en": "We used to play in the park.",
            "note": "nosotros → accent on the á"
          }
        ]
      },
      {
        "tag": "-ER / -IR",
        "heading": "-ER and -IR verbs → -ía",
        "body": "For <b>-er</b> and <b>-ir</b> verbs, add <b>-ía</b>. Every form keeps the accent on the <b>í</b>:",
        "conj": [
          [
            "comer → yo",
            "comía"
          ],
          [
            "comer → tú",
            "comías"
          ],
          [
            "comer → nosotros",
            "comíamos"
          ],
          [
            "vivir → yo",
            "vivía"
          ],
          [
            "vivir → él/ella",
            "vivía"
          ],
          [
            "vivir → ellos",
            "vivían"
          ]
        ],
        "ex": [
          {
            "es": "Antes <b>vivía</b> en Madrid.",
            "en": "I used to live in Madrid.",
            "note": "vivir → vivía"
          },
          {
            "es": "Siempre <b>comíamos</b> juntos.",
            "en": "We always ate together.",
            "note": "comer → comíamos"
          }
        ]
      },
      {
        "tag": "irregulares",
        "heading": "The only three irregulars: ser, ir, ver",
        "body": "Just three verbs are irregular in the imperfect — memorise them and you know them all:",
        "conj": [
          [
            "ser → era, eras, era…",
            "era"
          ],
          [
            "ir → iba, ibas, iba…",
            "iba"
          ],
          [
            "ver → veía, veías, veía…",
            "veía"
          ]
        ],
        "ex": [
          {
            "es": "Cuando <b>era</b> niño, <b>iba</b> a la playa.",
            "en": "When I was a child, I used to go to the beach.",
            "note": "ser → era, ir → iba"
          },
          {
            "es": "<b>Veía</b> la tele cada noche.",
            "en": "I used to watch TV every night.",
            "note": "ver → veía"
          }
        ]
      }
    ],
    "takeaways": [
      "-ar → -aba (hablaba); -er/-ir → -ía (comía, vivía).",
      "Use it for habits, descriptions, and ongoing past: “used to”, “was …-ing”.",
      "Only three irregulars: ser → era, ir → iba, ver → veía.",
      "-ía forms always keep the accent: comía, vivía, veía."
    ],
    "mistakes": [
      {
        "w": "Cuando fui niño, jugaba mucho.",
        "r": "Cuando era niño, jugaba mucho.",
        "why": "A description of the past uses the imperfect: era, not the preterite fui."
      },
      {
        "w": "Antes comia pan cada día.",
        "r": "Antes comía pan cada día.",
        "why": "The -ía ending always carries an accent: comía."
      },
      {
        "w": "De niño ibo al colegio a pie.",
        "r": "De niño iba al colegio a pie.",
        "why": "The yo form of ir in the imperfect is iba, not 'ibo'."
      }
    ]
  },
