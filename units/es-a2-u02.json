{
  "unit": {
    "id": "es-a2-u02",
    "title": "-AR preterite",
    "subtitle": "The completed past of -ar verbs: Ayer hablé con Ana",
    "level": "A2",
    "order": 2,
    "xp_reward": 20
  },
  "grammar": {
    "title": "The past that's over and done",
    "intro": "The <b>pretérito indefinido</b> is Spanish's main past tense for <b>completed</b> actions — things that happened and finished at a specific moment: <i><b>Ayer</b> hablé con Ana.</i> (Yesterday I spoke with Ana.) In this unit you'll master the regular <b>-ar</b> verbs. Watch the accents on <b>hablé</b> and <b>habló</b> — they change the meaning completely.",
    "sections": [
      {
        "tag": "terminaciones",
        "heading": "The -ar preterite endings",
        "body": "Take an -ar verb, drop the <b>-ar</b>, and add these endings. Notice the accents on the <b>yo</b> and <b>él/ella</b> forms — they carry the stress and are essential:",
        "conj": [
          [
            "yo",
            "hablé"
          ],
          [
            "tú",
            "hablaste"
          ],
          [
            "él/ella",
            "habló"
          ],
          [
            "nosotros",
            "hablamos"
          ],
          [
            "vosotros",
            "hablasteis"
          ],
          [
            "ellos",
            "hablaron"
          ]
        ],
        "ex": [
          {
            "es": "Ayer <b>hablé</b> con Ana.",
            "en": "Yesterday I spoke with Ana.",
            "note": "yo → hablé (accent!)"
          },
          {
            "es": "Ella <b>habló</b> con el médico.",
            "en": "She spoke with the doctor.",
            "note": "él/ella → habló"
          }
        ]
      },
      {
        "tag": "uso",
        "heading": "When to use it",
        "body": "Use the preterite for actions that are <b>finished</b>, usually with a time marker like <b>ayer</b> (yesterday) or <b>la semana pasada</b> (last week):",
        "conj": [
          [
            "yesterday",
            "ayer"
          ],
          [
            "last week",
            "la semana pasada"
          ],
          [
            "last night",
            "anoche"
          ],
          [
            "two days ago",
            "hace dos días"
          ]
        ],
        "ex": [
          {
            "es": "<b>La semana pasada</b> trabajé mucho.",
            "en": "Last week I worked a lot.",
            "note": "finished time period"
          },
          {
            "es": "<b>Ayer</b> estudié español.",
            "en": "Yesterday I studied Spanish.",
            "note": "estudiar → estudié"
          }
        ]
      },
      {
        "tag": "acentos",
        "heading": "The accent changes everything",
        "body": "Without its accent, <b>habló</b> (he/she spoke, past) becomes <b>hablo</b> (I speak, present). The little mark is the whole tense:",
        "conj": [
          [
            "I speak (now)",
            "hablo"
          ],
          [
            "he/she spoke",
            "habló"
          ],
          [
            "I spoke",
            "hablé"
          ]
        ],
        "ex": [
          {
            "es": "Yo <b>hablo</b> inglés.",
            "en": "I speak English.",
            "note": "present, no accent"
          },
          {
            "es": "Él <b>habló</b> ayer.",
            "en": "He spoke yesterday.",
            "note": "past, with accent"
          }
        ]
      }
    ],
    "takeaways": [
      "-ar preterite endings: -é, -aste, -ó, -amos, -asteis, -aron.",
      "Use it for completed past actions: Ayer hablé con Ana.",
      "Time markers: ayer, la semana pasada, anoche, hace dos días.",
      "Mind the accents: habló (past) vs hablo (present); hablé vs hablo."
    ],
    "mistakes": [
      {
        "w": "Ayer él hablo con Ana.",
        "r": "Ayer él habló con Ana.",
        "why": "The él/ella preterite needs the accent: habló, not hablo (which is present 'I speak')."
      },
      {
        "w": "Ayer hablo con Ana.",
        "r": "Ayer hablé con Ana.",
        "why": "For 'I spoke' use hablé; hablo means 'I speak' (present)."
      },
      {
        "w": "Ayer yo trabajé mucho ayer.",
        "r": "Ayer trabajé mucho.",
        "why": "One time marker is enough — don't double it."
      }
    ]
  },
