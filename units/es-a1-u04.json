{
  "unit": {
    "id": "es-a1-u04",
    "title": "-AR verbs",
    "subtitle": "Regular -AR verbs in the present tense",
    "level": "A1",
    "order": 4,
    "xp_reward": 20
  },
  "grammar": {
    "title": "One pattern unlocks hundreds of verbs",
    "intro": "Most Spanish verbs end in <b>-ar</b> (hablar, trabajar, estudiar). To use them, drop the <b>-ar</b> and add an ending that matches who’s doing the action. Learn this once and it works for <b>every</b> regular -AR verb.",
    "sections": [
      {
        "tag": "regla",
        "heading": "The endings",
        "body": "Take the stem (hablar → <b>habl-</b>) and add:",
        "conj": [
          [
            "yo",
            "-o"
          ],
          [
            "tú",
            "-as"
          ],
          [
            "él/ella",
            "-a"
          ],
          [
            "nosotros",
            "-amos"
          ],
          [
            "vosotros",
            "-áis"
          ],
          [
            "ellos",
            "-an"
          ]
        ],
        "ex": [
          {
            "es": "Estas terminaciones son <b>iguales</b> para todos los verbos -AR.",
            "en": "These endings are the same for every -AR verb.",
            "note": "the whole trick"
          }
        ]
      },
      {
        "tag": "hablar",
        "heading": "hablar (to speak) in action",
        "body": "Same stem, six endings:",
        "conj": [
          [
            "yo",
            "hablo"
          ],
          [
            "tú",
            "hablas"
          ],
          [
            "él/ella",
            "habla"
          ],
          [
            "nosotros",
            "hablamos"
          ],
          [
            "vosotros",
            "habláis"
          ],
          [
            "ellos",
            "hablan"
          ]
        ],
        "ex": [
          {
            "es": "Yo <b>hablo</b> español.",
            "en": "I speak Spanish.",
            "note": "yo → -o"
          },
          {
            "es": "Nosotros <b>trabajamos</b> en Madrid.",
            "en": "We work in Madrid.",
            "note": "nosotros → -amos"
          },
          {
            "es": "Ella <b>estudia</b> mucho.",
            "en": "She studies a lot.",
            "note": "ella → -a"
          }
        ]
      }
    ],
    "takeaways": [
      "Drop -ar, then add: -o, -as, -a, -amos, -áis, -an.",
      "The endings are identical for every regular -AR verb.",
      "Pronouns (yo, tú…) are optional — the ending already says who."
    ],
    "mistakes": [
      {
        "w": "Yo hablar español.",
        "r": "Yo hablo español.",
        "why": "Conjugate the verb — never leave it as the infinitive."
      },
      {
        "w": "Nosotros hablan.",
        "r": "Nosotros hablamos.",
        "why": "nosotros → -amos, not -an."
      }
    ]
  },
