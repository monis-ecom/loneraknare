{
  "unit": {
    "id": "es-a1-u14",
    "title": "Ir + future",
    "subtitle": "The verb ir and the near future (going to)",
    "level": "A1",
    "order": 14,
    "xp_reward": 20
  },
  "grammar": {
    "title": "Talk about the future with one easy verb",
    "intro": "<b>Ir</b> means “to go”. It’s short and irregular, but once you know it you can talk about <b>where</b> you go — and, best of all, about the <b>future</b>: “I’m going to eat” is just <b>ir + a + infinitive</b>. No new tense to learn.",
    "sections": [
      {
        "tag": "conjugación",
        "heading": "ir, conjugated",
        "body": "Only six little forms — memorise them:",
        "conj": [
          [
            "yo",
            "voy"
          ],
          [
            "tú",
            "vas"
          ],
          [
            "él/ella",
            "va"
          ],
          [
            "nosotros",
            "vamos"
          ],
          [
            "vosotros",
            "vais"
          ],
          [
            "ellos",
            "van"
          ]
        ],
        "ex": [
          {
            "es": "Yo <b>voy</b> a casa.",
            "en": "I'm going home.",
            "note": "yo → voy"
          },
          {
            "es": "Nosotros <b>vamos</b> juntos.",
            "en": "We're going together.",
            "note": "nosotros → vamos"
          }
        ]
      },
      {
        "tag": "lugar",
        "heading": "ir + a + place",
        "body": "To say where you go, use <b>ir + a</b>. Don’t drop the <b>a</b>. And remember: <b>a + el = al</b>:",
        "conj": [
          [
            "a + el",
            "al"
          ],
          [
            "a + la",
            "a la"
          ],
          [
            "Voy a + Madrid",
            "Voy a Madrid"
          ],
          [
            "Voy a + el cine",
            "Voy al cine"
          ]
        ],
        "ex": [
          {
            "es": "<b>Voy a</b> Madrid.",
            "en": "I'm going to Madrid.",
            "note": "always keep the a"
          },
          {
            "es": "<b>Voy al</b> cine.",
            "en": "I'm going to the cinema.",
            "note": "a + el = al"
          }
        ]
      },
      {
        "tag": "futuro",
        "heading": "The near future: ir + a + infinitive",
        "body": "This is the everyday way to talk about the future. Take <b>ir</b>, add <b>a</b>, then an <b>infinitive</b> (-ar/-er/-ir). It means “going to…”:",
        "ex": [
          {
            "es": "<b>Voy a comer</b>.",
            "en": "I'm going to eat.",
            "note": "voy + a + comer"
          },
          {
            "es": "<b>Vamos a estudiar</b> esta noche.",
            "en": "We're going to study tonight.",
            "note": "vamos + a + infinitive"
          },
          {
            "es": "Ella <b>va a viajar</b>.",
            "en": "She's going to travel.",
            "note": "never 'va a viaja'"
          }
        ]
      }
    ],
    "takeaways": [
      "ir: voy, vas, va, vamos, vais, van.",
      "ir + a + place: Voy a Madrid (keep the a).",
      "a + el = al: Voy al cine.",
      "ir + a + infinitive = the near future: Voy a comer = I'm going to eat."
    ],
    "mistakes": [
      {
        "w": "Voy Madrid.",
        "r": "Voy a Madrid.",
        "why": "After ir you need the preposition a."
      },
      {
        "w": "Voy a el cine.",
        "r": "Voy al cine.",
        "why": "a + el always contract to al."
      },
      {
        "w": "Voy a como.",
        "r": "Voy a comer.",
        "why": "Use the infinitive after 'a', not a conjugated verb."
      }
    ]
  },
