{
  "unit": {
    "id": "es-a1-u18",
    "title": "A1 Review",
    "subtitle": "Bring it all together — a capstone review of A1",
    "level": "A1",
    "order": 18,
    "xp_reward": 20
  },
  "grammar": {
    "title": "You’ve built a real foundation",
    "intro": "This is your capstone. No new grammar here — just a warm recap of the whole A1 journey. You can now greet people, describe things with <b>ser</b> and <b>estar</b>, conjugate regular verbs, say what you <b>like</b> and <b>have</b>, talk about the future with <b>ir a</b>, count, tell time, and ask real questions. Let’s mix it all together.",
    "sections": [
      {
        "tag": "identidad",
        "heading": "ser vs estar",
        "body": "<b>Ser</b> = who/what something is (identity, origin, permanent traits). <b>Estar</b> = how/where it is (location, feelings, states):",
        "conj": [
          [
            "origin / trait",
            "ser"
          ],
          [
            "location / feeling",
            "estar"
          ]
        ],
        "ex": [
          {
            "es": "Yo <b>soy</b> de España.",
            "en": "I am from Spain.",
            "note": "origin → ser"
          },
          {
            "es": "El libro <b>está</b> en la mesa.",
            "en": "The book is on the table.",
            "note": "location → estar"
          }
        ]
      },
      {
        "tag": "verbos",
        "heading": "Present tense + gustar + tener",
        "body": "Regular verbs follow steady endings; <b>gustar</b> flips the order; <b>tener</b> is your everyday “have”:",
        "conj": [
          [
            "-AR (hablar)",
            "hablo, hablas, habla…"
          ],
          [
            "-ER (comer)",
            "como, comes, come…"
          ],
          [
            "-IR (vivir)",
            "vivo, vives, vive…"
          ],
          [
            "like",
            "me gusta / me gustan"
          ],
          [
            "have",
            "tengo, tienes, tiene…"
          ]
        ],
        "ex": [
          {
            "es": "<b>Me gusta</b> el café.",
            "en": "I like coffee.",
            "note": "gustar: the thing is the subject"
          },
          {
            "es": "<b>Tengo</b> dos hermanos.",
            "en": "I have two brothers.",
            "note": "tener for possession"
          }
        ]
      },
      {
        "tag": "planes",
        "heading": "The future, numbers & questions",
        "body": "<b>Ir + a + infinitive</b> = going to do something. Add numbers, time, and question words to round it off:",
        "conj": [
          [
            "going to",
            "voy a + infinitive"
          ],
          [
            "how much / many",
            "¿cuánto?"
          ],
          [
            "where",
            "¿dónde?"
          ],
          [
            "what",
            "¿qué?"
          ]
        ],
        "ex": [
          {
            "es": "<b>Voy a</b> estudiar mañana.",
            "en": "I am going to study tomorrow.",
            "note": "ir a + infinitive"
          },
          {
            "es": "¿<b>Dónde</b> está el baño?",
            "en": "Where is the bathroom?",
            "note": "question word + estar"
          }
        ]
      }
    ],
    "takeaways": [
      "ser = identity/origin; estar = location/feelings.",
      "Regular verbs: -o, -as/-es, -a/-e… — the endings tell you who.",
      "gustar flips: me gusta (one thing) / me gustan (several).",
      "tener for having; ir a + infinitive for plans.",
      "Question words open the door: qué, dónde, cuánto, cómo."
    ],
    "mistakes": [
      {
        "w": "El libro es en la mesa.",
        "r": "El libro está en la mesa.",
        "why": "Location always uses estar, not ser."
      },
      {
        "w": "Yo gusto el café.",
        "r": "Me gusta el café.",
        "why": "gustar flips: the coffee “pleases me” → me gusta el café."
      }
    ]
  },
