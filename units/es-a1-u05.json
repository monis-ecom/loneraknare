{
  "unit": {
    "id": "es-a1-u05",
    "title": "-ER / -IR verbs",
    "subtitle": "Regular -ER and -IR verbs in the present",
    "level": "A1",
    "order": 5,
    "xp_reward": 20
  },
  "grammar": {
    "title": "Two more patterns — and they're almost the same",
    "intro": "You already know -AR verbs. <b>-ER</b> and <b>-IR</b> verbs work exactly the same way: drop the ending, add a new one. The best part — the -ER and -IR endings are <b>identical</b> except for the nosotros and vosotros forms.",
    "sections": [
      {
        "tag": "comer",
        "heading": "-ER verbs: comer (to eat)",
        "body": "Stem <b>com-</b> plus the -ER endings:",
        "conj": [
          [
            "yo",
            "como"
          ],
          [
            "tú",
            "comes"
          ],
          [
            "él/ella",
            "come"
          ],
          [
            "nosotros",
            "comemos"
          ],
          [
            "vosotros",
            "coméis"
          ],
          [
            "ellos",
            "comen"
          ]
        ],
        "ex": [
          {
            "es": "Yo <b>como</b> pan.",
            "en": "I eat bread.",
            "note": "yo → -o"
          },
          {
            "es": "Nosotros <b>bebemos</b> agua.",
            "en": "We drink water.",
            "note": "nosotros → -emos"
          }
        ]
      },
      {
        "tag": "vivir",
        "heading": "-IR verbs: vivir (to live)",
        "body": "Stem <b>viv-</b> plus the -IR endings:",
        "conj": [
          [
            "yo",
            "vivo"
          ],
          [
            "tú",
            "vives"
          ],
          [
            "él/ella",
            "vive"
          ],
          [
            "nosotros",
            "vivimos"
          ],
          [
            "vosotros",
            "vivís"
          ],
          [
            "ellos",
            "viven"
          ]
        ],
        "ex": [
          {
            "es": "Ella <b>vive</b> en Madrid.",
            "en": "She lives in Madrid.",
            "note": "ella → -e"
          },
          {
            "es": "<b>Escribimos</b> un correo.",
            "en": "We write an email.",
            "note": "nosotros → -imos"
          }
        ]
      },
      {
        "tag": "regla",
        "heading": "The only difference",
        "body": "-ER and -IR share -o, -es, -e, -en. They differ <b>only</b> in nosotros and vosotros:",
        "conj": [
          [
            "nosotros · -ER",
            "-emos"
          ],
          [
            "nosotros · -IR",
            "-imos"
          ],
          [
            "vosotros · -ER",
            "-éis"
          ],
          [
            "vosotros · -IR",
            "-ís"
          ]
        ],
        "ex": [
          {
            "es": "comemos vs. vivimos",
            "en": "we eat vs. we live",
            "note": "the tricky spot"
          }
        ]
      }
    ],
    "takeaways": [
      "-ER: -o, -es, -e, -emos, -éis, -en.",
      "-IR: -o, -es, -e, -imos, -ís, -en.",
      "They only differ in the nosotros/vosotros forms."
    ],
    "mistakes": [
      {
        "w": "Nosotros vivemos en Madrid.",
        "r": "Nosotros vivimos en Madrid.",
        "why": "-IR nosotros is -imos, not -emos: vivimos."
      },
      {
        "w": "Ella vivo aquí.",
        "r": "Ella vive aquí.",
        "why": "él/ella takes -e: vive."
      }
    ]
  },
