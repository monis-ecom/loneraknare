{
  "unit": {
    "id": "es-a1-u13",
    "title": "Tener (to have)",
    "subtitle": "The verb tener: age, feelings, and obligations",
    "level": "A1",
    "order": 13,
    "xp_reward": 20
  },
  "grammar": {
    "title": "One verb for having, feeling, and must-doing",
    "intro": "<b>Tener</b> means “to have”, but Spanish uses it far beyond possession. It tells your <b>age</b>, how you <b>feel</b> (hungry, cold, sleepy), and what you <b>have to do</b>. It’s irregular, so it’s worth memorising — you’ll use it every day.",
    "sections": [
      {
        "tag": "conjugación",
        "heading": "tener, conjugated",
        "body": "Notice two twists: the <b>yo</b> form adds a <b>g</b> (tengo), and the <b>e</b> changes to <b>ie</b> in most forms:",
        "conj": [
          [
            "yo",
            "tengo"
          ],
          [
            "tú",
            "tienes"
          ],
          [
            "él/ella",
            "tiene"
          ],
          [
            "nosotros",
            "tenemos"
          ],
          [
            "vosotros",
            "tenéis"
          ],
          [
            "ellos",
            "tienen"
          ]
        ],
        "ex": [
          {
            "es": "Yo <b>tengo</b> un hermano.",
            "en": "I have a brother.",
            "note": "yo → tengo"
          },
          {
            "es": "Nosotros <b>tenemos</b> tiempo.",
            "en": "We have time.",
            "note": "nosotros keeps the e"
          }
        ]
      },
      {
        "tag": "edad",
        "heading": "Your age: tener + [number] + años",
        "body": "To say your age, Spanish uses <b>tener</b>, not <b>ser</b>. Literally: “I have 25 years.”",
        "ex": [
          {
            "es": "<b>Tengo</b> 25 <b>años</b>.",
            "en": "I am 25 years old.",
            "note": "never 'soy 25'"
          },
          {
            "es": "Mi madre <b>tiene</b> 50 años.",
            "en": "My mother is 50 years old.",
            "note": "tiene + años"
          }
        ]
      },
      {
        "tag": "sensaciones",
        "heading": "Feelings: tener + noun",
        "body": "Many feelings use <b>tener</b> + a noun, where English uses “to be”:",
        "conj": [
          [
            "hungry",
            "tener hambre"
          ],
          [
            "thirsty",
            "tener sed"
          ],
          [
            "cold",
            "tener frío"
          ],
          [
            "hot",
            "tener calor"
          ],
          [
            "sleepy",
            "tener sueño"
          ],
          [
            "in a hurry",
            "tener prisa"
          ]
        ],
        "ex": [
          {
            "es": "<b>Tengo hambre</b> y <b>sed</b>.",
            "en": "I'm hungry and thirsty.",
            "note": "literally 'I have hunger'"
          },
          {
            "es": "Ella <b>tiene prisa</b>.",
            "en": "She's in a hurry.",
            "note": "tiene + prisa"
          }
        ]
      },
      {
        "tag": "obligación",
        "heading": "Obligation: tener que + infinitive",
        "body": "To say you <b>have to</b> do something, use <b>tener que</b> + the infinitive (the -ar/-er/-ir form). Keep the second verb in the infinitive:",
        "ex": [
          {
            "es": "<b>Tengo que estudiar</b>.",
            "en": "I have to study.",
            "note": "que + infinitive"
          },
          {
            "es": "<b>Tenemos que trabajar</b> hoy.",
            "en": "We have to work today.",
            "note": "never 'tenemos que trabajamos'"
          }
        ]
      }
    ],
    "takeaways": [
      "tener: tengo, tienes, tiene, tenemos, tenéis, tienen.",
      "Age uses tener, not ser: Tengo 25 años.",
      "Feelings: tener hambre / sed / frío / calor / sueño / prisa.",
      "tener que + infinitive = to have to do something."
    ],
    "mistakes": [
      {
        "w": "Yo teno un perro.",
        "r": "Yo tengo un perro.",
        "why": "The yo form adds a g: tengo, not teno."
      },
      {
        "w": "Soy 25 años.",
        "r": "Tengo 25 años.",
        "why": "Age uses tener, not ser."
      },
      {
        "w": "Tengo que estudio.",
        "r": "Tengo que estudiar.",
        "why": "After 'tener que', use the infinitive, not a conjugated verb."
      }
    ]
  },
