{
  "unit": {
    "id": "es-a2-u11",
    "title": "Por vs para",
    "subtitle": "Two words for 'for' — and when to use each",
    "level": "A2",
    "order": 11,
    "xp_reward": 20
  },
  "grammar": {
    "title": "The famous por / para split",
    "intro": "English has one word — <b>for</b> — where Spanish has two: <b>por</b> and <b>para</b>. The quick rule: <b>para</b> looks <b>forward</b> to a purpose, goal, or destination; <b>por</b> looks <b>back</b> to a cause, or covers exchange, duration, and movement through. Learn the buckets and it clicks.",
    "sections": [
      {
        "tag": "para",
        "heading": "PARA = purpose, goal, destination",
        "body": "Use <b>para</b> for the aim or endpoint: <b>in order to</b>, a <b>destination</b>, a <b>deadline</b>, or a <b>recipient</b>.",
        "conj": [
          [
            "purpose",
            "para aprender"
          ],
          [
            "destination",
            "para Madrid"
          ],
          [
            "deadline",
            "para el lunes"
          ],
          [
            "recipient",
            "para ti"
          ]
        ],
        "ex": [
          {
            "es": "Estudio <b>para aprender</b>.",
            "en": "I study (in order) to learn.",
            "note": "para + infinitive = purpose"
          },
          {
            "es": "Este regalo es <b>para ti</b>.",
            "en": "This gift is for you.",
            "note": "recipient"
          }
        ]
      },
      {
        "tag": "por",
        "heading": "POR = cause, exchange, duration, through",
        "body": "Use <b>por</b> for the reason behind something, a <b>price/exchange</b>, a <b>length of time</b>, or <b>movement through</b> a place.",
        "conj": [
          [
            "reason/cause",
            "por el tráfico"
          ],
          [
            "exchange/price",
            "por 10 euros"
          ],
          [
            "duration",
            "por dos horas"
          ],
          [
            "through",
            "por el parque"
          ]
        ],
        "ex": [
          {
            "es": "Llego tarde <b>por el tráfico</b>.",
            "en": "I'm late because of the traffic.",
            "note": "cause"
          },
          {
            "es": "Lo compré <b>por 10 euros</b>.",
            "en": "I bought it for 10 euros.",
            "note": "price/exchange"
          }
        ]
      },
      {
        "tag": "gracias",
        "heading": "Thanks and set phrases",
        "body": "Saying thanks uses <b>por</b>, because you're thanking for a <b>cause</b>. And <b>por favor</b> is fixed — just memorise it.",
        "ex": [
          {
            "es": "<b>Gracias por</b> tu ayuda.",
            "en": "Thanks for your help.",
            "note": "gracias por = thanks for"
          },
          {
            "es": "Un café, <b>por favor</b>.",
            "en": "A coffee, please.",
            "note": "fixed phrase"
          }
        ]
      },
      {
        "tag": "contraste",
        "heading": "Purpose vs cause — the tricky pair",
        "body": "The classic mix-up: <b>para</b> = the goal you're aiming at; <b>por</b> = the reason that made it happen. Compare them side by side.",
        "ex": [
          {
            "es": "Estudio <b>para</b> el examen.",
            "en": "I study for the exam. (goal)",
            "note": "para = purpose"
          },
          {
            "es": "Estudio <b>por</b> mis padres.",
            "en": "I study because of / for the sake of my parents.",
            "note": "por = cause/motive"
          }
        ]
      }
    ],
    "takeaways": [
      "PARA = purpose (para aprender), destination (para Madrid), deadline (para el lunes), recipient (para ti).",
      "POR = cause (por el tráfico), exchange (por 10 euros), duration (por dos horas), through (por el parque).",
      "Thanks uses por: Gracias por tu ayuda.",
      "para + infinitive = in order to.",
      "por favor is a fixed phrase."
    ],
    "mistakes": [
      {
        "w": "Estudio para el tráfico.",
        "r": "Llego tarde por el tráfico.",
        "why": "Traffic is a cause, not a goal → por, not para."
      },
      {
        "w": "Gracias para tu ayuda.",
        "r": "Gracias por tu ayuda.",
        "why": "Thanking is about a cause → gracias por."
      },
      {
        "w": "Este regalo es por ti.",
        "r": "Este regalo es para ti.",
        "why": "You are the recipient/destination of the gift → para."
      }
    ]
  },
