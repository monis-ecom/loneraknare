{
  "unit": {
    "id": "es-b1-u12",
    "title": "Por vs para — advanced & set phrases",
    "subtitle": "Deeper por/para and the fixed phrases natives use",
    "level": "B1",
    "order": 12,
    "xp_reward": 20
  },
  "grammar": {
    "title": "From the rules to the phrases natives actually say",
    "intro": "You met <b>por</b> and <b>para</b> at A2. Now we go deeper — the finer uses of each — and, just as important, the <b>fixed phrases</b> where you simply have to know which one it is: <b>por cierto</b>, <b>por supuesto</b>, <b>para siempre</b>. Memorise the buckets, then memorise the phrases.",
    "sections": [
      {
        "tag": "por",
        "heading": "POR — cause, means, exchange, approximate, reason",
        "body": "<b>por</b> covers the <b>cause</b> or motive, the <b>means</b> (how), an <b>exchange</b>, and <b>approximate</b> time or place. Also <b>por + infinitive</b> = the reason something happened.",
        "conj": [
          [
            "cause",
            "por amor"
          ],
          [
            "means",
            "por email"
          ],
          [
            "exchange",
            "por 20 euros"
          ],
          [
            "approximate",
            "por aquí"
          ]
        ],
        "ex": [
          {
            "es": "Te escribo <b>por email</b>.",
            "en": "I'll write to you by email.",
            "note": "means / how"
          },
          {
            "es": "Lo hago <b>por</b> no molestar.",
            "en": "I do it so as not to bother (out of not wanting to bother).",
            "note": "por + infinitive = reason"
          }
        ]
      },
      {
        "tag": "para",
        "heading": "PARA — purpose, goal, deadline, recipient, opinion",
        "body": "<b>para</b> points forward: a <b>purpose</b> or goal, a <b>deadline</b>, a <b>recipient</b>, and your <b>opinion</b> (<b>para mí</b> = in my opinion / for me).",
        "conj": [
          [
            "purpose",
            "para estudiar"
          ],
          [
            "deadline",
            "para el viernes"
          ],
          [
            "recipient",
            "para ti"
          ],
          [
            "opinion",
            "para mí"
          ]
        ],
        "ex": [
          {
            "es": "Estudio <b>para</b> un examen.",
            "en": "I'm studying for an exam.",
            "note": "goal"
          },
          {
            "es": "<b>Para mí</b>, es la mejor opción.",
            "en": "For me / in my opinion, it's the best option.",
            "note": "para mí = opinion"
          }
        ]
      },
      {
        "tag": "fijas",
        "heading": "Fixed phrases — just memorise these",
        "body": "These don't follow a rule you can reason out; they're set. Learn them as whole chunks:",
        "conj": [
          [
            "por cierto",
            "by the way"
          ],
          [
            "por supuesto",
            "of course"
          ],
          [
            "por lo menos",
            "at least"
          ],
          [
            "por eso",
            "that's why"
          ],
          [
            "para siempre",
            "forever"
          ]
        ],
        "ex": [
          {
            "es": "<b>Por supuesto</b>, te ayudo.",
            "en": "Of course, I'll help you.",
            "note": "fixed"
          },
          {
            "es": "Te quiero <b>para siempre</b>.",
            "en": "I love you forever.",
            "note": "para siempre = forever"
          }
        ]
      },
      {
        "tag": "gracias",
        "heading": "Thanking and giving reasons",
        "body": "Thanks uses <b>por</b> (you thank for a cause). And <b>por eso</b> links a reason to its result.",
        "ex": [
          {
            "es": "Gracias <b>por</b> venir.",
            "en": "Thanks for coming.",
            "note": "gracias por + infinitive"
          },
          {
            "es": "Llueve; <b>por eso</b> llevo paraguas.",
            "en": "It's raining; that's why I'm carrying an umbrella.",
            "note": "por eso = that's why"
          }
        ]
      }
    ],
    "takeaways": [
      "POR = cause, means (por email), exchange (por 20 euros), approximate (por aquí), reason (por + infinitive).",
      "PARA = purpose, deadline (para el viernes), recipient (para ti), opinion (para mí).",
      "Fixed with por: por cierto, por supuesto, por lo menos, por eso.",
      "Fixed with para: para siempre.",
      "Gracias por venir — thanking uses por."
    ],
    "mistakes": [
      {
        "w": "Para cierto, ¿vienes mañana?",
        "r": "Por cierto, ¿vienes mañana?",
        "why": "‘By the way’ is a fixed phrase with por: por cierto."
      },
      {
        "w": "Gracias para venir.",
        "r": "Gracias por venir.",
        "why": "You thank for a cause → gracias por."
      },
      {
        "w": "Te quiero por siempre.",
        "r": "Te quiero para siempre.",
        "why": "‘Forever’ is a fixed phrase with para: para siempre."
      }
    ]
  },
