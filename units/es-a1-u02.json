{
  "unit": {
    "id": "es-a1-u02",
    "title": "Articles",
    "subtitle": "el · la · los · las (and un / una)",
    "level": "A1",
    "order": 2,
    "xp_reward": 20
  },
  "grammar": {
    "title": "Every noun has a gender — and “the” has to match",
    "intro": "In Spanish every noun is either <b>masculine</b> or <b>feminine</b>, and the word for “the” changes to match — with a separate plural form too. A handy rule of thumb: nouns ending in <b>-o</b> are usually masculine, <b>-a</b> usually feminine.",
    "sections": [
      {
        "tag": "definido",
        "heading": "“The” — the definite article",
        "body": "Four words, all meaning “the”. Match the noun's gender and number:",
        "conj": [
          [
            "masculine · singular",
            "el"
          ],
          [
            "feminine · singular",
            "la"
          ],
          [
            "masculine · plural",
            "los"
          ],
          [
            "feminine · plural",
            "las"
          ]
        ],
        "ex": [
          {
            "es": "<b>el</b> libro / <b>los</b> libros",
            "en": "the book / the books",
            "note": "masculine"
          },
          {
            "es": "<b>la</b> mesa / <b>las</b> mesas",
            "en": "the table / the tables",
            "note": "feminine"
          }
        ]
      },
      {
        "tag": "indefinido",
        "heading": "“A” and “some” — the indefinite article",
        "body": "Same idea, for “a / an” and “some”:",
        "conj": [
          [
            "a (m)",
            "un"
          ],
          [
            "a (f)",
            "una"
          ],
          [
            "some (m)",
            "unos"
          ],
          [
            "some (f)",
            "unas"
          ]
        ],
        "ex": [
          {
            "es": "<b>un</b> perro, <b>una</b> silla",
            "en": "a dog, a chair",
            "note": "one of something"
          }
        ]
      }
    ],
    "takeaways": [
      "el · la · los · las all mean “the” — match gender AND number.",
      "-o is usually masculine (el), -a usually feminine (la).",
      "un / una = a · unos / unas = some."
    ],
    "mistakes": [
      {
        "w": "el casa",
        "r": "la casa",
        "why": "Casa ends in -a and is feminine → la casa."
      },
      {
        "w": "la problema",
        "r": "el problema",
        "why": "A few -a words are masculine: el problema, el día, el mapa. Learn these as exceptions."
      }
    ]
  },
