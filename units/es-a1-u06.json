{
  "unit": {
    "id": "es-a1-u06",
    "title": "Gustar",
    "subtitle": "Saying what you like — me gusta, te gusta",
    "level": "A1",
    "order": 6,
    "xp_reward": 20
  },
  "grammar": {
    "title": "The verb that works backwards",
    "intro": "“Me gusta el café” isn't literally “I like the coffee.” It means <b>“coffee is pleasing to me.”</b> Spanish flips it: the thing you like is the subject, and <b>you</b> are along for the ride (me, te, le…). Two forms cover almost everything.",
    "sections": [
      {
        "tag": "mecanismo",
        "heading": "Start with who likes it",
        "body": "Put an indirect pronoun first — it means “to me / to you / to him…” — then the gustar form, then the thing:",
        "conj": [
          [
            "to me",
            "me"
          ],
          [
            "to you",
            "te"
          ],
          [
            "to him/her",
            "le"
          ],
          [
            "to us",
            "nos"
          ],
          [
            "to you all",
            "os"
          ],
          [
            "to them",
            "les"
          ]
        ],
        "ex": [
          {
            "es": "<b>Me</b> gusta el café.",
            "en": "I like coffee. (lit. coffee is pleasing to me)",
            "note": "me = to me"
          }
        ]
      },
      {
        "tag": "gusta",
        "heading": "gusta vs. gustan",
        "body": "Use <b>gusta</b> for one thing or an action. Use <b>gustan</b> for several things:",
        "conj": [
          [
            "one thing",
            "gusta"
          ],
          [
            "an action",
            "gusta"
          ],
          [
            "several things",
            "gustan"
          ]
        ],
        "ex": [
          {
            "es": "Me <b>gusta</b> la música.",
            "en": "I like music.",
            "note": "one thing → gusta"
          },
          {
            "es": "Me <b>gustan</b> los gatos.",
            "en": "I like cats.",
            "note": "plural → gustan"
          },
          {
            "es": "Me <b>gusta</b> bailar.",
            "en": "I like to dance.",
            "note": "action → gusta"
          }
        ]
      }
    ],
    "takeaways": [
      "gustar = “to be pleasing” — the thing you like is the subject.",
      "me · te · le · nos · os · les say WHO likes it.",
      "gusta = one thing or an action · gustan = several things."
    ],
    "mistakes": [
      {
        "w": "Yo gusto el café.",
        "r": "Me gusta el café.",
        "why": "Don't conjugate gustar like a normal verb — use me + gusta."
      },
      {
        "w": "Me gustan la música.",
        "r": "Me gusta la música.",
        "why": "One thing (la música) → gusta, not gustan."
      }
    ]
  },
