  "unit": {
    "id": "es-a1-u03",
    "title": "Ser vs. Estar",
    "subtitle": "Two verbs for “to be” — and when to use each",
    "level": "A1",
    "order": 3,
    "xp_reward": 20
  },
  "grammar": {
    "title": "Why does Spanish have TWO words for “to be”?",
    "intro": "English uses one verb for everything. Spanish splits it in two. The rule of thumb: <b>SER</b> = what something <b>is</b> (permanent). <b>ESTAR</b> = how or where something is <b>right now</b> (temporary + location).",
    "sections": [
      {
        "tag": "ser",
        "heading": "SER — permanent / identity",
        "body": "Identity, origin, profession, nationality — things that don’t change.",
        "conj": [
          [
            "yo",
            "soy"
          ],
          [
            "tú",
            "eres"
          ],
          [
            "él/ella",
            "es"
          ],
          [
            "nosotros",
            "somos"
          ],
          [
            "vosotros",
            "sois"
          ],
          [
            "ellos",
            "son"
          ]
        ],
        "ex": [
          {
            "es": "Yo <b>soy</b> de Suecia.",
            "en": "I am from Sweden.",
            "note": "origin"
          },
          {
            "es": "Ella <b>es</b> profesora.",
            "en": "She is a teacher.",
            "note": "profession"
          }
        ]
      },
      {
        "tag": "estar",
        "heading": "ESTAR — temporary / location",
        "body": "Feelings, temporary conditions, and where something is. Memory hook: <b>LoCo</b> = Location + Condition → estar.",
        "conj": [
          [
            "yo",
            "estoy"
          ],
          [
            "tú",
            "estás"
          ],
          [
            "él/ella",
            "está"
          ],
          [
            "nosotros",
            "estamos"
          ],
          [
            "vosotros",
            "estáis"
          ],
          [
            "ellos",
            "están"
          ]
        ],
        "ex": [
          {
            "es": "<b>Estoy</b> cansado.",
            "en": "I am tired.",
            "note": "feeling"
          },
          {
            "es": "<b>Estamos</b> en casa.",
            "en": "We are at home.",
            "note": "location"
          }
        ]
      }
    ],
    "takeaways": [
      "SER = permanent identity (who/what something is).",
      "ESTAR = temporary state + location (how/where it is now).",
      "Location ALWAYS uses estar — even “Madrid está en España.”"
    ],
    "mistakes": [
      {
        "w": "Yo soy en casa.",
        "r": "Yo estoy en casa.",
        "why": "Location always uses estar, never ser."
      },
      {
        "w": "Ella está profesora.",
        "r": "Ella es profesora.",
        "why": "Profession is identity → ser."
      }
    ]
  },
