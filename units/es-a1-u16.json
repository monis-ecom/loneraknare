  },
  "grammar": {
    "title": "What are you doing right now?",
    "intro": "To say an action is happening <b>at this very moment</b>, Spanish uses <b>estar</b> (which you already know) plus a special verb form called the <b>gerund</b> — the <b>-ing</b> form. So “I'm speaking” = <b>estoy hablando</b>. It's just two pieces: estar + gerund.",
    "sections": [
      {
        "tag": "gerundio",
        "heading": "Building the gerund",
        "body": "Drop the infinitive ending and add the gerund ending: <b>-ar → -ando</b>, <b>-er/-ir → -iendo</b>:",
        "conj": [
          [
            "hablar",
            "hablando"
          ],
          [
            "comer",
            "comiendo"
          ],
          [
            "vivir",
            "viviendo"
          ],
          [
            "escribir",
            "escribiendo"
          ]
        ],
        "ex": [
          {
            "es": "hablar → <b>hablando</b>",
            "en": "speaking",
            "note": "-ar verbs → -ando"
          },
          {
            "es": "comer → <b>comiendo</b>",
            "en": "eating",
            "note": "-er/-ir verbs → -iendo"
          }
        ]
      },
      {
        "tag": "estar",
        "heading": "estar + gerund",
        "body": "Conjugate <b>estar</b> for the subject, then add the gerund (which never changes):",
        "conj": [
          [
            "yo",
            "estoy hablando"
          ],
          [
            "tú",
            "estás comiendo"
          ],
          [
            "él/ella",
            "está viviendo"
          ],
          [
            "nosotros",
            "estamos escribiendo"
          ],
          [
            "ellos",
            "están hablando"
          ]
        ],
        "ex": [
          {
            "es": "<b>Estoy hablando</b> por teléfono.",
            "en": "I'm talking on the phone.",
            "note": "right now"
          },
          {
            "es": "Ellos <b>están comiendo</b> ahora.",
            "en": "They are eating now.",
            "note": "ahora = now"
          }
        ]
      },
      {
        "tag": "contraste",
        "heading": "Simple present vs. right now",
        "body": "Use the simple present for habits and general facts; use estar + gerund only for what's happening <b>at this moment</b>:",
        "ex": [
          {
            "es": "<b>Hablo</b> español.",
            "en": "I speak Spanish.",
            "note": "general — a skill I have"
          },
          {
            "es": "<b>Estoy hablando</b> con Ana.",
            "en": "I'm speaking with Ana.",
            "note": "right now, in progress"
          }
        ]
      }
    ],
    "takeaways": [
      "Present continuous = estar + gerund (estoy hablando).",
      "Gerund: -ar → -ando; -er/-ir → -iendo.",
      "Simple present = habits/facts; estar + gerund = happening right now."
    ],
    "mistakes": [
      {
        "w": "Yo soy hablando.",
        "r": "Estoy hablando.",
        "why": "The present continuous always uses estar, never ser."
      },
      {
        "w": "Estoy comando.",
        "r": "Estoy comiendo.",
        "why": "comer is an -er verb, so the gerund is comiendo, not comando."
      }
    ]
  },
