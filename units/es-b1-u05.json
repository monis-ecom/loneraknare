{
  "unit": {
    "id": "es-b1-u05",
    "title": "Commands + pronouns",
    "subtitle": "dámelo vs no me lo des: attaching and placing pronouns",
    "level": "B1",
    "order": 5,
    "xp_reward": 20
  },
  "grammar": {
    "title": "Where pronouns go with orders",
    "intro": "Object pronouns (<b>me, te, lo, la, se…</b>) behave differently depending on whether the command is a <b>yes</b> or a <b>no</b>. With an <b>affirmative</b> command they <b>attach to the end</b> of the verb (often needing a written accent): <b>dime</b>, <b>dámelo</b>. With a <b>negative</b> command they jump <b>in front</b>: <b>no me lo des</b>. Learn the switch and you'll sound instantly more natural.",
    "sections": [
      {
        "tag": "afirmativo",
        "heading": "Affirmative: attach to the end",
        "body": "Stick the pronoun(s) onto the back of the command. Because the word grows longer, you usually add a <b>written accent</b> to keep the stress in place:",
        "conj": [
          ["di + me", "dime"],
          ["da + me + lo", "dámelo"],
          ["levanta + te", "levántate"],
          ["cuenta + me + lo", "cuéntamelo"]
        ],
        "ex": [
          {
            "es": "<b>Dámelo</b>, por favor.",
            "en": "Give it to me, please.",
            "note": "da + me + lo → dámelo"
          },
          {
            "es": "<b>Levántate</b>, es tarde.",
            "en": "Get up, it's late.",
            "note": "levanta + te → levántate"
          }
        ]
      },
      {
        "tag": "negativo",
        "heading": "Negative: pronoun goes before",
        "body": "With <b>no</b>, the pronouns detach and sit <b>between no and the verb</b> — no accent gymnastics needed:",
        "conj": [
          ["no + me + lo + des", "no me lo des"],
          ["no + te + levantes", "no te levantes"],
          ["no + lo + hagas", "no lo hagas"]
        ],
        "ex": [
          {
            "es": "<b>No me lo des</b> todavía.",
            "en": "Don't give it to me yet.",
            "note": "pronouns before the verb"
          },
          {
            "es": "<b>No te levantes</b>, descansa.",
            "en": "Don't get up, rest.",
            "note": "no + te + levantes"
          }
        ]
      },
      {
        "tag": "el orden",
        "heading": "Pronoun order: indirect before direct",
        "body": "When you have two pronouns, the <b>indirect</b> (to whom) comes before the <b>direct</b> (what): <b>me lo</b>, <b>te lo</b>. And when both would start with l-, the indirect turns into <b>se</b>: le lo → <b>se lo</b>.",
        "ex": [
          {
            "es": "<b>Cuéntamelo</b> todo.",
            "en": "Tell me all of it.",
            "note": "me (indirect) + lo (direct)"
          },
          {
            "es": "<b>Dáselo</b> a ella.",
            "en": "Give it to her.",
            "note": "le + lo → se lo → dáselo"
          }
        ]
      }
    ],
    "takeaways": [
      "Affirmative command → pronouns attach to the end: dime, dámelo, levántate.",
      "Negative command → pronouns go before the verb: no me lo des, no te levantes.",
      "Order is indirect + direct: me lo, te lo; le+lo becomes se lo.",
      "Attaching pronouns usually needs a written accent: dámelo, cuéntamelo."
    ],
    "mistakes": [
      {
        "w": "Da me lo.",
        "r": "Dámelo.",
        "why": "In affirmative commands the pronouns attach as one word, with an accent: dámelo."
      },
      {
        "w": "No dámelo.",
        "r": "No me lo des.",
        "why": "In negative commands the pronouns go before the verb, which stays subjunctive: no me lo des."
      },
      {
        "w": "Cuentamelo todo.",
        "r": "Cuéntamelo todo.",
        "why": "Attaching two pronouns needs the written accent: cuéntamelo."
      }
    ]
  },
