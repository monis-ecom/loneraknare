  "unit": {
    "id": "es-a2-u14",
    "title": "Commands (affirmative tú)",
    "subtitle": "Telling a friend to do something",
    "level": "A2",
    "order": 14,
    "xp_reward": 20
  },
  "grammar": {
    "title": "Give an order to someone you know",
    "intro": "When you tell a friend or family member <b>to do</b> something — <b>“Come here!”</b>, <b>“Speak slower!”</b> — you use the affirmative <b>tú</b> command. For most verbs it's a form you already recognise, and there are just eight irregulars to memorise.",
    "sections": [
      {
        "tag": "regulares",
        "heading": "The regular command = the él/ella present",
        "body": "For regular verbs, the tú command is identical to the <b>he/she</b> form of the present tense. Just drop the final <b>-s</b> from the tú form:",
        "conj": [
          [
            "hablar",
            "habla"
          ],
          [
            "comer",
            "come"
          ],
          [
            "escribir",
            "escribe"
          ],
          [
            "abrir",
            "abre"
          ],
          [
            "leer",
            "lee"
          ]
        ],
        "ex": [
          {
            "es": "¡<b>Habla</b> más despacio!",
            "en": "Speak slower!",
            "note": "hablar → habla"
          },
          {
            "es": "<b>Come</b> la verdura, por favor.",
            "en": "Eat the vegetables, please.",
            "note": "comer → come"
          }
        ]
      },
      {
        "tag": "irregulares",
        "heading": "The eight irregulars",
        "body": "These common verbs have short, unique command forms. They're worth memorising as a set — you'll hear them constantly:",
        "conj": [
          [
            "decir",
            "di"
          ],
          [
            "hacer",
            "haz"
          ],
          [
            "ir",
            "ve"
          ],
          [
            "poner",
            "pon"
          ],
          [
            "salir",
            "sal"
          ],
          [
            "ser",
            "sé"
          ],
          [
            "tener",
            "ten"
          ],
          [
            "venir",
            "ven"
          ]
        ],
        "ex": [
          {
            "es": "¡<b>Ven</b> aquí!",
            "en": "Come here!",
            "note": "venir → ven"
          },
          {
            "es": "<b>Haz</b> la tarea ahora.",
            "en": "Do the homework now.",
            "note": "hacer → haz"
          }
        ]
      },
      {
        "tag": "uso",
        "heading": "Everyday orders and directions",
        "body": "Use these to give instructions, directions, and friendly encouragement. A single word often does the whole job:",
        "ex": [
          {
            "es": "<b>Mira</b> esto, es increíble.",
            "en": "Look at this, it's amazing.",
            "note": "mirar → mira"
          },
          {
            "es": "<b>Ten</b> paciencia, por favor.",
            "en": "Be patient, please.",
            "note": "tener → ten"
          }
        ]
      }
    ],
    "takeaways": [
      "Regular tú command = the él/ella present form: habla, come, escribe.",
      "Eight irregulars: di, haz, ve, pon, sal, sé, ten, ven.",
      "Never use the infinitive as a command (not 'hablar', but 'habla').",
      "One word is often a full order: ¡Ven! ¡Mira! ¡Haz!"
    ],
    "mistakes": [
      {
        "w": "¡Hablar más despacio!",
        "r": "¡Habla más despacio!",
        "why": "Don't use the infinitive as a command — use the él/ella form: habla."
      },
      {
        "w": "¡Hace la tarea!",
        "r": "¡Haz la tarea!",
        "why": "Hacer is irregular: the command is haz, not hace."
      },
      {
        "w": "¡Vene aquí!",
        "r": "¡Ven aquí!",
        "why": "Venir is irregular: the command is simply ven."
      }
    ]
  },
