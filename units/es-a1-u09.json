  },
  "grammar": {
    "title": "Talk about your family and what's yours",
    "intro": "Spanish family words come in matched pairs — <b>madre/padre</b>, <b>hermano/hermana</b>. To say <b>my</b>, <b>your</b>, or <b>our</b>, you use possessive adjectives, and they change to match the noun. Add <b>de</b> and you can say who owns what.",
    "sections": [
      {
        "tag": "familia",
        "heading": "The family",
        "body": "Most family words pair a masculine and a feminine form:",
        "conj": [
          [
            "madre / padre",
            "mother / father"
          ],
          [
            "hermana / hermano",
            "sister / brother"
          ],
          [
            "hija / hijo",
            "daughter / son"
          ],
          [
            "abuela / abuelo",
            "grandmother / grandfather"
          ],
          [
            "tía / tío",
            "aunt / uncle"
          ]
        ],
        "ex": [
          {
            "es": "Ella es mi <b>madre</b>.",
            "en": "She is my mother.",
            "note": "ser for relationships"
          },
          {
            "es": "Tengo un <b>hermano</b> y una <b>hermana</b>.",
            "en": "I have a brother and a sister.",
            "note": "one of each"
          }
        ]
      },
      {
        "tag": "posesivos",
        "heading": "my · your · his/her — agree in NUMBER",
        "body": "<b>mi, tu, su</b> add <b>-s</b> only when the noun is plural — the gender doesn't matter:",
        "conj": [
          [
            "mi / mis",
            "my"
          ],
          [
            "tu / tus",
            "your"
          ],
          [
            "su / sus",
            "his / her / their"
          ]
        ],
        "ex": [
          {
            "es": "<b>mi</b> hermano · <b>mis</b> hermanos",
            "en": "my brother · my brothers",
            "note": "singular vs plural"
          },
          {
            "es": "<b>su</b> hija · <b>sus</b> hijas",
            "en": "his daughter · his daughters",
            "note": "-s only for plural"
          }
        ]
      },
      {
        "tag": "nuestro",
        "heading": "our — agrees in GENDER and NUMBER",
        "body": "<b>nuestro</b> is fussier: it matches both the gender and the number of the noun.",
        "conj": [
          [
            "nuestro",
            "our (masc. sing.)"
          ],
          [
            "nuestra",
            "our (fem. sing.)"
          ],
          [
            "nuestros",
            "our (masc. pl.)"
          ],
          [
            "nuestras",
            "our (fem. pl.)"
          ]
        ],
        "ex": [
          {
            "es": "<b>nuestra</b> madre",
            "en": "our mother",
            "note": "madre is feminine"
          },
          {
            "es": "<b>nuestros</b> abuelos",
            "en": "our grandparents",
            "note": "masculine plural"
          }
        ]
      },
      {
        "tag": "de",
        "heading": "Showing possession with «de»",
        "body": "There's no apostrophe-s in Spanish. Flip it around with <b>de</b> (of):",
        "ex": [
          {
            "es": "el libro <b>de</b> Ana",
            "en": "Ana's book",
            "note": "the book of Ana"
          },
          {
            "es": "la madre <b>de</b> Juan",
            "en": "Juan's mother",
            "note": "the mother of Juan"
          }
        ]
      }
    ],
    "takeaways": [
      "mi/tu/su add -s only for plural nouns: mi hermano → mis hermanos.",
      "nuestro matches gender AND number: nuestra madre, nuestros hijos.",
      "No 's in Spanish — use de: la casa de María.",
      "Use ser to say who someone is: es mi padre."
    ],
    "mistakes": [
      {
        "w": "mis hermano",
        "r": "mi hermano",
        "why": "hermano is singular, so use mi — mis is only for plural."
      },
      {
        "w": "nuestro madre",
        "r": "nuestra madre",
        "why": "madre is feminine, so nuestro becomes nuestra."
      }
    ]
  },
