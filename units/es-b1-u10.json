{
  "unit": {
    "id": "es-b1-u10",
    "title": "The passive & impersonal se",
    "subtitle": "Say what people do in general — without naming who",
    "level": "B1",
    "order": 10,
    "xp_reward": 20
  },
  "grammar": {
    "title": "One little word for 'one, you, they, people'",
    "intro": "How do you say “English is spoken here” or “they need waiters” without naming a subject? Spanish reaches for <b>se</b>. It turns a verb impersonal — meaning <b>one</b>, <b>you</b>, <b>they</b>, or <b>people in general</b> — and it's everywhere: on signs, in rules, in the news. The one trap: the verb must <b>agree</b> with the thing that follows.",
    "sections": [
      {
        "tag": "impersonal",
        "heading": "Impersonal se: no subject at all",
        "body": "Use <b>se</b> + a <b>third-person singular</b> verb to talk about what people do generally. There's no “who” — it's the same as English “one does”, “you do”, or “they do”.",
        "conj": [
          [
            "one speaks",
            "se habla"
          ],
          [
            "one says",
            "se dice"
          ],
          [
            "one can",
            "se puede"
          ],
          [
            "one lives",
            "se vive"
          ]
        ],
        "ex": [
          {
            "es": "Aquí <b>se habla</b> inglés.",
            "en": "English is spoken here.",
            "note": "no named speaker"
          },
          {
            "es": "En España <b>se cena</b> tarde.",
            "en": "In Spain people have dinner late.",
            "note": "people in general"
          }
        ]
      },
      {
        "tag": "acuerdo",
        "heading": "Passive se: the verb agrees with the noun",
        "body": "When a thing receives the action, the verb <b>agrees</b> with that thing: singular thing → singular verb, plural things → plural verb. This is the mistake everyone makes.",
        "conj": [
          [
            "a house is sold",
            "se vende casa"
          ],
          [
            "houses are sold",
            "se venden casas"
          ],
          [
            "a waiter is needed",
            "se necesita camarero"
          ],
          [
            "waiters are needed",
            "se necesitan camareros"
          ]
        ],
        "ex": [
          {
            "es": "<b>Se vende</b> un piso.",
            "en": "A flat is for sale.",
            "note": "one flat → singular"
          },
          {
            "es": "<b>Se venden</b> casas.",
            "en": "Houses for sale.",
            "note": "plural noun → venden"
          }
        ]
      },
      {
        "tag": "frases",
        "heading": "Everyday se phrases",
        "body": "A few you'll see constantly on signs and in speech: <b>se dice que…</b> (they say that…), <b>se puede</b> (one can / is it allowed), <b>se necesita</b> (is needed / wanted).",
        "ex": [
          {
            "es": "<b>Se dice que</b> va a llover.",
            "en": "They say it's going to rain.",
            "note": "se dice que + clause"
          },
          {
            "es": "¿<b>Se puede</b> pagar con tarjeta?",
            "en": "Can one pay by card?",
            "note": "se puede + infinitive"
          }
        ]
      },
      {
        "tag": "ser",
        "heading": "A note on the true passive: ser + participle",
        "body": "Spanish also has a formal passive with <b>ser</b> + past participle (like English “was built”), but it's mostly for writing and news. In everyday Spanish, prefer <b>se</b>.",
        "ex": [
          {
            "es": "El puente <b>fue construido</b> en 1900.",
            "en": "The bridge was built in 1900.",
            "note": "formal / written"
          },
          {
            "es": "Aquí <b>se construyó</b> un puente.",
            "en": "A bridge was built here.",
            "note": "everyday se version"
          }
        ]
      }
    ],
    "takeaways": [
      "Impersonal se + singular verb = one / you / they / people in general.",
      "Passive se: the verb agrees with the noun — se vende casa, se venden casas.",
      "Handy phrases: se dice que…, se puede, se necesita(n).",
      "The formal passive ser + participle (fue construido) is mostly for writing — use se in speech."
    ],
    "mistakes": [
      {
        "w": "Se vende casas.",
        "r": "Se venden casas.",
        "why": "The noun is plural (casas), so the verb must be plural: se venden."
      },
      {
        "w": "Se necesita camareros.",
        "r": "Se necesitan camareros.",
        "why": "Camareros is plural → se necesitan, not se necesita."
      },
      {
        "w": "Aquí habla inglés.",
        "r": "Aquí se habla inglés.",
        "why": "To make it impersonal (‘is spoken’), you need se."
      }
    ]
  },
